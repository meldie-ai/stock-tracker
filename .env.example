DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Optional. Only needed if DATABASE_URL points at a PgBouncer transaction-mode pooler
# (e.g. Supabase's "Transaction pooler") — that pooling mode doesn't support the
# session-level advisory lock `prisma migrate deploy` needs, and the build will hang
# indefinitely without this. Set to a connection that keeps one session per query
# instead (Supabase's "Session pooler", or a true direct connection). Not needed for
# providers whose main URL already supports this (e.g. Neon) — leave unset there.
MIGRATE_DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
SESSION_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
CRON_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
SEED_ADMIN_USERNAME="your-username"
SEED_ADMIN_PASSWORD="a-strong-password-change-after-first-login"
# Shown in the header, browser tab, and login screen — set to a different value per
# shop's Vercel project (e.g. "Shop 1" / "Shop 2") so staff working at more than one
# shop can tell which one they're in before they act. Must be NEXT_PUBLIC_ since the
# login screen renders it client-side, before a session exists.
NEXT_PUBLIC_SHOP_NAME="Shop 1"
