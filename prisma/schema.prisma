// Prisma schema for stock-tracker

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String
  role              Role      @default(STAFF)
  // Soft-delete: the app never hard-deletes a User row (shift history and
  // audit log entries must stay intact after someone quits), so
  // Shift.startedByUserId's ON DELETE RESTRICT is never exercised.
  deactivatedAt     DateTime?
  // Bumped on every admin-driven password reset so an already-issued
  // session cookie (SessionData.issuedAt) can be invalidated immediately,
  // instead of staying valid until it naturally expires.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?

  shiftsStarted Shift[] @relation("ShiftStartedBy")
  shiftsEnded   Shift[] @relation("ShiftEndedBy")

  loginAttempts LoginAttempt[]
  auditLogs     AuditLog[]
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

model Category {
  id             String    @id @default(cuid())
  name           String
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  // When set, every product in this category shares these one cash/card
  // prices instead of having its own — for categories where every item
  // costs the same (e.g. all vape flavours), rather than setting the same
  // price on each product individually. Null means products keep
  // individual prices.
  cashPriceCents Int?
  cardPriceCents Int?
  dealNote       String?
  products       Product[]
}

model Product {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  stockCount     Int      @default(0)
  // Selling prices in cents (not a float) to avoid currency rounding bugs.
  // Nullable: existing/new products start with no price set. Two separate
  // prices since card payments typically cost more than cash here.
  cashPriceCents Int?
  cardPriceCents Int?
  // Plain text bundle note (e.g. "3 for $50") — not a calculated price
  // override.
  dealNote       String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // When set, selling/adjusting this product down to exactly 0 decrements
  // the linked product by 1 and refills this product back up to PACK_SIZE
  // (e.g. a Singles pack refilling from its Cartons product). An explicit
  // link chosen in Manage, rather than matching by category/product name —
  // name-matching proved fragile in practice (silently breaks on any
  // spelling or whitespace drift between the two lists).
  linkedCartonProductId String?
  linkedCartonProduct   Product?  @relation("SinglesCartonLink", fields: [linkedCartonProductId], references: [id], onDelete: SetNull)
  linkedBySingles       Product[] @relation("SinglesCartonLink")

  shiftSales          ShiftSale[]
  shiftStockSnapshots ShiftStockSnapshot[]
  auditLogs           AuditLog[]
}

enum ShiftStatus {
  ACTIVE
  CLOSED
}

enum AuditAction {
  SELL
  ADJUST
  CASCADE
  PRICE_CHANGE
}

model AuditLog {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  action    AuditAction

  userId           String?
  user             User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  usernameSnapshot String

  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  categoryNameSnapshot String

  quantityDelta Int
  stockBefore   Int
  stockAfter    Int

  // Informational only, no FK: Shift rows purge at 7 days but AuditLog
  // lives 14, so a real relation would go stale for half the row's life.
  shiftId String?
  note    String?

  @@index([createdAt])
  @@index([userId])
  @@index([productId])
}

model Shift {
  id              String      @id @default(cuid())
  status          ShiftStatus @default(ACTIVE)
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  startedByUserId String
  startedByUser   User        @relation("ShiftStartedBy", fields: [startedByUserId], references: [id])
  endedByUserId   String?
  endedByUser     User?       @relation("ShiftEndedBy", fields: [endedByUserId], references: [id])

  dayLabel       String?
  dateRangeLabel String?
  timeRangeLabel String?

  sales          ShiftSale[]
  stockSnapshots ShiftStockSnapshot[]

  @@index([status])
  @@index([endedAt])
}

model ShiftSale {
  id                   String   @id @default(cuid())
  shiftId              String
  shift                Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  categoryNameSnapshot String
  categorySortOrder    Int      @default(0)
  sortOrder            Int      @default(0)
  soldCount            Int      @default(0)

  @@unique([shiftId, productId])
  @@index([shiftId])
}

model ShiftStockSnapshot {
  id                   String   @id @default(cuid())
  shiftId              String
  shift                Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  categoryNameSnapshot String
  categorySortOrder    Int      @default(0)
  sortOrder            Int      @default(0)
  stockCountAtClose    Int

  @@unique([shiftId, productId])
  @@index([shiftId])
}
