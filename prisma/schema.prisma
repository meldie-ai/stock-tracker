// Prisma schema for stock-tracker

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String
  role              Role      @default(STAFF)
  // Soft-delete: the app never hard-deletes a User row (shift history and
  // audit log entries must stay intact after someone quits), so
  // Shift.startedByUserId's ON DELETE RESTRICT is never exercised.
  deactivatedAt     DateTime?
  // Bumped on every admin-driven password reset so an already-issued
  // session cookie (SessionData.issuedAt) can be invalidated immediately,
  // instead of staying valid until it naturally expires.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?

  shiftsStarted Shift[] @relation("ShiftStartedBy")
  shiftsEnded   Shift[] @relation("ShiftEndedBy")

  loginAttempts LoginAttempt[]
  auditLogs     AuditLog[]
  shiftNotes    ShiftNote[]
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

model Category {
  id             String    @id @default(cuid())
  name           String
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  // When set, every product in this category shares these one cash/card
  // prices instead of having its own — for categories where every item
  // costs the same (e.g. all vape flavours), rather than setting the same
  // price on each product individually. Null means products keep
  // individual prices.
  cashPriceCents Int?
  cardPriceCents Int?
  dealNote       String?
  // Cash-only "N for $X" bundle deal, structured for calculation (dealNote stays
  // as free display text alongside this). Same category-overrides-product
  // precedence as cashPriceCents/cardPriceCents: when set here, every product in
  // the category shares this one deal instead of having its own.
  dealQuantity   Int?
  dealPriceCents Int?
  products       Product[]
}

model Product {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  stockCount     Int      @default(0)
  // Selling prices in cents (not a float) to avoid currency rounding bugs.
  // Nullable: existing/new products start with no price set. Two separate
  // prices since card payments typically cost more than cash here.
  cashPriceCents Int?
  cardPriceCents Int?
  // Plain text bundle note (e.g. "3 for $50") — not a calculated price
  // override.
  dealNote       String?
  // Structured cash-only deal used by the deal cart, e.g. dealQuantity=3,
  // dealPriceCents=4000 for "3 for $40". Different products in the same category
  // can carry different deals (e.g. cigarette brands priced/deal'd individually);
  // the deal cart only lets products with an identical dealQuantity+dealPriceCents
  // combine into one sale. Ignored when the category has its own deal set.
  dealQuantity   Int?
  dealPriceCents Int?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // When set, selling/adjusting this product down to exactly 0 decrements
  // the linked product by 1 and refills this product back up to PACK_SIZE
  // (e.g. a Singles pack refilling from its Cartons product). An explicit
  // link chosen in Manage, rather than matching by category/product name —
  // name-matching proved fragile in practice (silently breaks on any
  // spelling or whitespace drift between the two lists).
  linkedCartonProductId String?
  linkedCartonProduct   Product?  @relation("SinglesCartonLink", fields: [linkedCartonProductId], references: [id], onDelete: SetNull)
  linkedBySingles       Product[] @relation("SinglesCartonLink")

  shiftSales          ShiftSale[]
  shiftStockSnapshots ShiftStockSnapshot[]
  auditLogs           AuditLog[]
}

enum ShiftStatus {
  ACTIVE
  CLOSED
}

enum AuditAction {
  SELL
  ADJUST
  CASCADE
  PRICE_CHANGE
  UNDO_SALE
}

enum PaymentMethod {
  CASH
  CARD
}

model AuditLog {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  action    AuditAction

  userId           String?
  user             User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  usernameSnapshot String

  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  categoryNameSnapshot String

  quantityDelta Int
  stockBefore   Int
  stockAfter    Int

  // Informational only, no FK: Shift and AuditLog rows are purged by
  // separate, non-transactional cron deletes, so a real relation could
  // still go stale between the two even though both currently keep 30 days.
  shiftId String?
  note    String?

  @@index([createdAt])
  @@index([userId])
  @@index([productId])
}

model Shift {
  id              String      @id @default(cuid())
  status          ShiftStatus @default(ACTIVE)
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  startedByUserId String
  startedByUser   User        @relation("ShiftStartedBy", fields: [startedByUserId], references: [id])
  endedByUserId   String?
  endedByUser     User?       @relation("ShiftEndedBy", fields: [endedByUserId], references: [id])

  dayLabel       String?
  dateRangeLabel String?
  timeRangeLabel String?

  sales          ShiftSale[]
  stockSnapshots ShiftStockSnapshot[]
  notes          ShiftNote[]

  @@index([status])
  @@index([endedAt])
}

model ShiftSale {
  id                   String   @id @default(cuid())
  shiftId              String
  shift                Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  categoryNameSnapshot String
  categorySortOrder    Int      @default(0)
  sortOrder            Int      @default(0)
  soldCount            Int      @default(0)
  // Null on rows from before payment-method tracking was added; every sale going forward
  // sets one. A product can now have up to two rows per shift, one per method.
  paymentMethod        PaymentMethod?
  // Amount actually charged for soldCount units in this row, locked in at the
  // moment of each sale (unit price × quantity, or an allocated share of a deal's
  // total) — not recomputed later from the current price, so later price/deal
  // changes never retroactively alter past revenue.
  revenueCentsCollected Int     @default(0)

  @@unique([shiftId, productId, paymentMethod])
  @@index([shiftId])
}

model ShiftStockSnapshot {
  id                   String   @id @default(cuid())
  shiftId              String
  shift                Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  categoryNameSnapshot String
  categorySortOrder    Int      @default(0)
  sortOrder            Int      @default(0)
  stockCountAtClose    Int

  @@unique([shiftId, productId])
  @@index([shiftId])
}

// A running, append-only log any staff member can add to while a shift is active — e.g.
// handover context, stock issues, till discrepancies. Not editable once written; carried
// into the shift's permanent History record after it closes.
model ShiftNote {
  id               String   @id @default(cuid())
  shiftId          String
  shift            Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  usernameSnapshot String
  text             String
  createdAt        DateTime @default(now())

  @@index([shiftId])
}
